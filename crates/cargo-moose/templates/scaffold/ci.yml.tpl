# Generated by `cargo moose new` — fast, cross-platform CI out of the box.
name: CI

on:
  push:
    branches: ['**']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: $\{\{ github.workflow }}-$\{\{ github.ref }}
  cancel-in-progress: true

# No RUSTFLAGS here: it would override `[target.*].rustflags` in
# `.cargo/config.toml`. Rust 1.90+ already links with rust-lld on
# x86_64 Linux, and debug-info settings live in `[profile.dev]`.
env:
  CARGO_TERM_COLOR: always
  CARGO_INCREMENTAL: 0

jobs:
  check:
    name: fmt & clippy
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - name: Linux system deps
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            pkg-config libx11-dev libx11-xcb-dev libxcb1-dev libxcb-dri2-0-dev \
            libxcb-icccm4-dev libxcursor-dev libxkbcommon-dev libxkbcommon-x11-dev \
            libxrandr-dev libgl1-mesa-dev libegl1-mesa-dev libvulkan-dev \
            libwayland-dev libasound2-dev libjack-jackd2-dev libfontconfig1-dev \
            libfreetype-dev
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
        with:
          key: check
          save-if: $\{\{ github.ref == 'refs/heads/main' }}
      - name: Format check
        run: cargo fmt --all -- --check
      - name: Clippy
        run: cargo clippy --workspace --all-targets -- -D warnings

  test:
    name: test ($\{\{ matrix.os }})
    runs-on: $\{\{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-24.04, macos-15, windows-2025]
    steps:
      - uses: actions/checkout@v4
      - name: Linux system deps
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential pkg-config \
            libx11-dev libx11-xcb-dev libxcb1-dev libxcb-dri2-0-dev \
            libxcb-icccm4-dev libxcursor-dev libxkbcommon-dev libxkbcommon-x11-dev \
            libxrandr-dev libgl1-mesa-dev libegl1-mesa-dev libvulkan-dev \
            libwayland-dev libasound2-dev libjack-jackd2-dev libfontconfig1-dev \
            libfreetype-dev
      - uses: dtolnay/rust-toolchain@stable
      - uses: taiki-e/install-action@nextest
      - uses: Swatinem/rust-cache@v2
        with:
          key: test-$\{\{ matrix.os }}
          save-if: $\{\{ github.ref == 'refs/heads/main' }}
      - name: Unit & integration tests
        run: cargo nextest run --workspace --no-tests=pass
      - name: Zero-RT-allocation tests (rt-paranoid)
        run: |
{{- for c in rt_paranoid_crates }}
          cargo nextest run -p {c} --features rt-paranoid --no-tests=pass
{{- endfor }}

  build:
    name: release build ($\{\{ matrix.os }})
    needs: check
    runs-on: $\{\{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-24.04, macos-15, windows-2025]
    steps:
      - uses: actions/checkout@v4
      - name: Linux system deps
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential pkg-config \
            libx11-dev libx11-xcb-dev libxcb1-dev libxcb-dri2-0-dev \
            libxcb-icccm4-dev libxcursor-dev libxkbcommon-dev libxkbcommon-x11-dev \
            libxrandr-dev libgl1-mesa-dev libegl1-mesa-dev libvulkan-dev \
            libwayland-dev libasound2-dev libjack-jackd2-dev libfontconfig1-dev \
            libfreetype-dev
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          key: build-$\{\{ matrix.os }}
          save-if: $\{\{ github.ref == 'refs/heads/main' }}
      - name: Build release
        run: cargo build --workspace --release
